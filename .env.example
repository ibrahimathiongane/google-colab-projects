# Copy to .env and adjust before running docker compose.
# .env is gitignored — never commit real secrets.

# REQUIRED — 32+ random bytes, e.g.:  openssl rand -hex 32
JWT_SECRET=

# Database
POSTGRES_USER=habit
POSTGRES_PASSWORD=habit
POSTGRES_DB=habit_tracker
# Host port for PostgreSQL (5432 is often taken by other local projects)
POSTGRES_PORT=5433

# Host ports
GATEWAY_PORT=8000
FRONTEND_PORT=5173

# Comma-separated browser origins allowed by the gateway CORS policy
ALLOWED_ORIGINS=http://localhost:5173

# Password reset email (users service)
# Public base URL of the SPA — reset links point to {APP_URL}/reset-password
APP_URL=http://localhost:5173
# SMTP relay (any provider: Resend, Postmark, Brevo, SES...).
# SMTP_HOST empty = the reset link is logged instead of emailed (dev mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@localhost

# ---- Production only (docker-compose.prod.yml + Caddy) — see DEPLOY.md ----
# Required on the server (the prod compose file fails fast without them):
#   DOMAIN=example.com                 # marketing apex (landing)
#   APP_HOST=app.example.com           # app subdomain (SPA + /api)
#   ALLOWED_ORIGINS=https://app.example.com
#   JWT_SECRET=$(openssl rand -hex 32)
#   POSTGRES_PASSWORD=$(openssl rand -hex 24)
