# Copy to .env and adjust before running docker compose.
# .env is gitignored — never commit real secrets.

# REQUIRED — 32+ random bytes, e.g.:  openssl rand -hex 32
JWT_SECRET=

# Database
POSTGRES_USER=habit
POSTGRES_PASSWORD=habit
POSTGRES_DB=habit_tracker
# Host port for PostgreSQL (5432 is often taken by other local projects)
POSTGRES_PORT=5433

# Host ports
GATEWAY_PORT=8000
FRONTEND_PORT=5173

# Comma-separated browser origins allowed by the gateway CORS policy
ALLOWED_ORIGINS=http://localhost:5173
