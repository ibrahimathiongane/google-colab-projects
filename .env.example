# Copy to .env and adjust before running docker compose.
# .env is gitignored — never commit real secrets.

# REQUIRED — 32+ random bytes, e.g.:  openssl rand -hex 32
JWT_SECRET=

# Database
POSTGRES_USER=habit
POSTGRES_PASSWORD=habit
POSTGRES_DB=habit_tracker
# Host port for PostgreSQL (5432 is often taken by other local projects)
POSTGRES_PORT=5433

# Host ports
GATEWAY_PORT=8000
FRONTEND_PORT=5173

# Comma-separated browser origins allowed by the gateway CORS policy.
# Mobile dev: add the Capacitor WebView origin (http://localhost) too.
ALLOWED_ORIGINS=http://localhost:5173

# Password reset email (users service)
# Public base URL of the SPA — reset links point to {APP_URL}/reset-password
APP_URL=http://localhost:5173
# SMTP relay (any provider: Resend, Postmark, Brevo, SES...).
# SMTP_HOST empty = the reset link is logged instead of emailed (dev mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@localhost

# Billing — Stripe (billing service; start with test keys from the dashboard)
# Empty STRIPE_SECRET_KEY = checkout/portal endpoints answer 503 "not configured".
STRIPE_SECRET_KEY=
# Webhook signing secret (endpoint: POST /api/billing/webhooks) — required in prod.
STRIPE_WEBHOOK_SECRET=
# Price IDs (prod): subscription (Pro/year) and one-time (Lifetime).
STRIPE_PRICE_PRO=
STRIPE_PRICE_LIFETIME=

# Web Push reminders (notifications service)
# Generate a key pair — paste the output here (keep VAPID_PRIVATE_KEY secret):
#   python scripts/gen-vapid-keys.py
# Empty keys = subscribe/vapid-public-key answer 503 "not configured".
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost
# Scheduler tuning (defaults shown; REMINDER_LOOP=off pauses it)
# REMINDER_INTERVAL_SECONDS=30
# REMINDER_LOOP=on

# Landing SEO/analytics (build-time, landing service)
# Canonical URL — used for og:*, canonical, robots.txt, sitemap.xml
# (prod compose derives it from DOMAIN: https://$DOMAIN).
# VITE_SITE_URL=http://localhost:5174
# Optional Plausible-compatible analytics (no cookies → no consent banner):
# VITE_ANALYTICS_SRC=https://plausible.io/js/script.js
# VITE_ANALYTICS_DOMAIN=yourdomain.com

# ---- Production only (docker-compose.prod.yml + Caddy) — see DEPLOY.md ----
# Required on the server (the prod compose file fails fast without them):
#   DOMAIN=example.com                 # marketing apex (landing)
#   APP_HOST=app.example.com           # app subdomain (SPA + /api)
#   ALLOWED_ORIGINS=https://app.example.com
#   JWT_SECRET=$(openssl rand -hex 32)
#   POSTGRES_PASSWORD=$(openssl rand -hex 24)

# ---- Vercel only (see README "Vercel (services)") ----
# Shared secret for POST /api/migrations/upgrade (gateway → migrations service).
# MIGRATE_TOKEN=$(openssl rand -hex 32)
